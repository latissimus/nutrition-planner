{
  "name": "nutrition-planner",
  "private": true,
  "license": "UNLICENSED",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "icons": "node scripts/gen-icons.mjs",
    "test": "vitest run",
    "audit": "npm audit --audit-level=high",
    "check:migrations": "node scripts/check-migrations.mjs",
    "eval:coach": "node --disable-warning=ExperimentalWarning scripts/coach-evals/run.mjs",
    "eval:coaching": "node --disable-warning=ExperimentalWarning scripts/coach-evals/coaching-eval.mjs",
    "coach:wissensbasis": "node --disable-warning=ExperimentalWarning scripts/coach-evals/sync-wissensbasis.mjs",
    "check:ypsi-formula": "node scripts/check-ypsi-formula-workbook.mjs",
    "check:seminar-knowledge": "python3 -m unittest discover -s scripts/seminar-audit -p 'test_*.py' && python3 scripts/seminar-audit/validate_knowledge.py",
    "check": "npm run check:migrations && npm run check:ypsi-formula && npm test && npm run build",
    "backup:supabase": "node scripts/backup-supabase.mjs",
    "backup:verify": "node scripts/verify-backup.mjs",
    "audio:optimize": "node scripts/optimize-meditation-audio.mjs",
    "audio:generate-binaural": "node scripts/generate-binaural-audio.mjs"
  },
  "dependencies": {
    "@fontsource/figtree": "^5.3.0",
    "@supabase/supabase-js": "^2.58.0",
    "@zxing/browser": "^0.2.1",
    "uisfx": "^0.4.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "vite": "^7.1.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1"
  }
}
